# Enforce LF line endings for all text
* text=auto eol=lf

# Source code: normalize to LF
*.cpp text
*.h   text
*.cs  text
*.csproj text
*.sln text
*.cmake text
CMakeLists.txt text
CMakePresets.json text
vcpkg.json text
vcpkg-configuration.json text
*.yml text
*.yaml text
*.md text
*.txt text
*.json text
*.sh text
*.ps1 text eol=crlf   # allow PowerShell scripts to have CRLF if needed

# Binary artifacts: always binary, no diff
*.dll  binary
*.dylib binary
*.so   binary
*.pdb  binary
*.exe  binary
*.lib  binary
*.a    binary
*.yak  binary
*.zip  binary
*.png  binary
*.ico  binary
*.resx binary
*.resources binary

# Prevent Git from attempting to merge lock/manifest artifacts
packages.lock.json merge=union