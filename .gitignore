# Build outputs
/build/windows/dev/
/build/release/*/
/build/*/
**/build/

# Exclude only generated binaries, keep release folders
# (allow empty release/ version directories to be committed if desired)
!build/release/
!build/release/**/.keep

# CMake
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake

# vcpkg build artifacts
vcpkg_installed/
.vcpkg-root
.vcpkg/
/vcpkg
/docs
/scripts
# Visual Studio (if devs open in VS Folder View)
.vs/
*.vcxproj.user

# Rider / VSCode / other IDE junk
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# .NET build outputs
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]*/
[Aa][Rr][Mm]64/
bin/
obj/
*.exe
*.dll
*.dylib
*.so
*.pdb
*.cache
*.log

# NuGet
*.nupkg
*.snupkg
packages/
.nuget/

# Yak build artifacts
*.yak

# OS files
.DS_Store
Thumbs.db
desktop.ini
